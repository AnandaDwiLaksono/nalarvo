{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nalarvo",
  "version": "0.1.0",
  "identifier": "com.nalarvo.desktop",
  "build": {
    "beforeDevCommand": "cargo build --manifest-path ../../Cargo.toml -p nalarvo-daemon && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build --release --manifest-path ../../Cargo.toml -p nalarvo-daemon && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nalarvo",
        "width": 960,
        "height": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset:; style-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
